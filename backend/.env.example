# Environment
ENVIRONMENT=development
DEBUG=true

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/nexora.db
# For production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nexora

# Redis (caching, rate limiting, token blacklist)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Security
SECRET_KEY=change-me-in-production-use-a-strong-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Field-level encryption key for sensitive database columns.
# IMPORTANT: production MUST set a dedicated value (e.g. a Fernet key).
# Leave empty for development (a key is derived from SECRET_KEY).
ENCRYPTION_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Logging
LOG_LEVEL=INFO

# Inbound webhooks (Shopify)
# Must match the secret configured in your Shopify app's webhook settings.
# Leave empty to disable Shopify webhook verification (webhooks will be rejected).
SHOPIFY_WEBHOOK_SECRET=

# Email notifications (SMTP)
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
SITE_URL=http://localhost:3000

# Qwen (通义千问) AI API
# Get a free key at https://dashscope.console.aliyun.com
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
