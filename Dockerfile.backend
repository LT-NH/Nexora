# Nexora backend image.
# Build from the repository root:  docker build -f Dockerfile.backend -t nexora-backend .
#
# 基础镜像用带大版本号的 slim tag 而非 latest。若要完全可复现，
# 建议进一步固定到 digest：FROM python:3.13-slim@sha256:<digest>
FROM python:3.13-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install Python dependencies first for better layer caching.
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the backend application.
COPY backend/ .

# 建非 root 用户并改属主：进程被攻破时不应直接拥有容器内 root 权限。
# 顺序很重要 —— 必须在 COPY 之后 chown，否则应用文件仍归 root 所有。
RUN mkdir -p /app/data /app/uploads \
    && chmod +x /app/entrypoint.sh \
    && useradd --create-home --shell /usr/sbin/nologin nexora \
    && chown -R nexora:nexora /app
USER nexora

EXPOSE 8000

# 健康检查走 /health：数据库不可用时该端点已会返回 503，因此能真实反映依赖状态。
# 用 python 而非 curl —— slim 镜像里没有 curl。
HEALTHCHECK --interval=30s --timeout=6s --start-period=45s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)" || exit 1

# 启动前：Alembic 迁移（幂等）→ 空库自动播种 90 天演示数据 → 启动 API
CMD ["sh", "/app/entrypoint.sh"]
