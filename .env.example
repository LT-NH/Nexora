# Nexora - 环境变量模板
# 复制此文件为 .env 并修改配置

# 数据库（SQLite 本地文件，无需额外配置）
DATABASE_URL=sqlite+aiosqlite:///./data/nexora.db

# 安全密钥（生产环境务必修改为随机字符串！）
SECRET_KEY=change-me-in-production-use-a-strong-random-secret-key

# JWT 配置
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 允许的来源（JSON 数组格式）
CORS_ORIGINS=["http://localhost:80","http://localhost:3000","http://localhost:5173"]

# 日志级别
LOG_LEVEL=INFO

# 速率限制
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60